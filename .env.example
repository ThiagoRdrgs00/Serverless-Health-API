# Copie este arquivo para .env e preencha com sua chave real.

# Usada pelo GeminiTriagemService (ativo por padrao em shared/container/services.ts).
# Gerar em https://aistudio.google.com/apikey - tier gratuito, sem cartao de credito.
GEMINI_API_KEY=

# Usada pelo AnthropicTriagemService (implementacao alternativa, ver
# domain/services/ITriagemService.ts). So necessaria se voce trocar a
# fiacao em shared/container/services.ts para usar Anthropic em vez do Gemini.
ANTHROPIC_API_KEY=
